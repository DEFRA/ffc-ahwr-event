{
  "name": "ffc-ahwr-event",
  "version": "0.9.2",
  "description": "Azure Function to process Vet Vists back office events",
  "author": "Defra",
  "main": "ffc-ahwr-event/index.mjs",
  "engines": {
    "npm": ">=11.10.0"
  },
  "scripts": {
    "lint": "eslint --cache --cache-strategy content \"**/*.{mjs,cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "lint:knip": "knip --production --exclude binaries,exports",
    "start": "func start -p 7080",
    "start:detached": "func start -p 7080 1> /dev/null 2> /dev/null &",
    "start:verbose": "func start -p 7080 --verbose",
    "test": "jest",
    "test:watch": "jest --coverage=false --onlyChanged --watch",
    "pretest": "npm run lint"
  },
  "dependencies": {
    "@azure/data-tables": "^13.2.0",
    "@azure/identity": "4.2.1",
    "ffc-protective-monitoring": "^1.0.4",
    "joi": "17.6.4"
  },
  "overrides": {
    "fast-xml-parser": "5.8.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@types/jest": "^27.0.0",
    "eslint": "9.29.0",
    "husky": "9.1.7",
    "knip": "6.29.0",
    "nano-staged": "1.0.2",
    "neostandard": "0.13.0",
    "babel-jest": "30.1.2",
    "jest": "30.2.0",
    "jest-junit": "17.0.0",
    "jest-when": "3.7.0"
  },
  "homepage": "https://github.com/DEFRA/ffc-ahwr-event",
  "repository": {
    "type": "git",
    "url": "https://github.com/DEFRA/ffc-ahwr-event.git"
  },
  "babel": {
    "plugins": [
      "@babel/plugin-transform-modules-commonjs"
    ]
  },
  "nano-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
